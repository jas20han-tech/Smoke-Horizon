# Backend configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./db.sqlite3

# API Keys
# Get a free NASA FIRMS MAPS API key here: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=

# OpenAQ API key (optional, used if you want real CPCB monitoring data)
OPENAQ_API_KEY=

# ── Twilio WhatsApp Alerts ─────────────────────────────────────
# Sign up at https://www.twilio.com/try-twilio
# For sandbox testing: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Sandbox number (default) or your verified Twilio WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
